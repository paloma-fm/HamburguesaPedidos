# ============================================================
# Variables de entorno para Docker Compose
# Copia este archivo como ".env" y ajusta los valores:
#   cp .env.example .env
# ============================================================

# Puerto del microservicio de pedidos (host)
SERVER_PORT=8081

# Configuración de MySQL
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=db_pedidosx
MYSQL_USER=root
MYSQL_PORT=3306

# Puerto del mock de notificaciones (host)
NOTIFICACIONES_PORT=8082

# Puerto de Adminer (interfaz de base de datos)
ADMINER_PORT=8090
